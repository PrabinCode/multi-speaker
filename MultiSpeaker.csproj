<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon); WPF has none of its own. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MultiSpeaker</RootNamespace>
    <ApplicationIcon>Assets\MultiSpeaker.ico</ApplicationIcon>
    <!-- Local builds show "dev"; release builds pass -p:Version from the git tag. -->
    <Version>0.0.0-dev</Version>
    <Product>MultiSpeaker</Product>
    <Copyright>Copyright (c) 2026 Prabin</Copyright>
    <!-- WPF0001: the Fluent ThemeMode API is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\MultiSpeaker.ico" />
    <!-- Keep WinForms names out of the global usings so they don't clash with WPF's. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

</Project>
