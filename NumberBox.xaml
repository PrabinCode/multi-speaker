<UserControl x:Class="MultiSpeaker.NumberBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StepButton" TargetType="RepeatButton" BasedOn="{StaticResource {x:Type RepeatButton}}">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Delay" Value="350" />
            <Setter Property="Interval" Value="60" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <RepeatButton Style="{StaticResource StepButton}" Content="&#xE738;" ToolTip="Decrease" Click="OnDecrease" />
        <!-- Own template: the Fluent one adds a clear (✕) button that covers the number in a box this narrow. -->
        <TextBox x:Name="Input" Grid.Column="1" Margin="4,0" MinWidth="56" MinHeight="0"
                 TextAlignment="Center" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}">
            <TextBox.Template>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Field" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource MutedTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Field" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </TextBox.Template>
        </TextBox>
        <RepeatButton Grid.Column="2" Style="{StaticResource StepButton}" Content="&#xE710;" ToolTip="Increase" Click="OnIncrease" />
    </Grid>
</UserControl>
